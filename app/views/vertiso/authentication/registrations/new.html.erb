<h1>
  <%= t(".title") %>
</h1>

<%= form_with scope: :registration, url: registration_path do |form| %>
  <div>
    <%= form.label :email, t(".email") %>
    <%= form.email_field :email, autocomplete: "email", required: true %>
  </div>
  <div>
    <%= form.label :user_name, t(".user_name") %>
    <%= form.text_field :user_name, autocomplete: "username", required: true %>
  </div>
  <div>
    <%= form.label :password, t(".password") %>
    <%= form.password_field :password, autocomplete: "new-password", required: true %>
  </div>
  <div>
    <%= form.label :password_confirmation, t(".password_confirmation") %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
  </div>
  <%= form.submit t(".submit") %>
<% end %>
