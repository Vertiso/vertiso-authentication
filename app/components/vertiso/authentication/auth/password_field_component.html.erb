<div class="vertiso-auth-fields">
  <div class="vertiso-auth-field">
    <%= form.label :password,
                   t("vertiso.authentication.components.password_field.password"),
                   class: "vertiso-auth-field__label #{theme.foreground}" %>
    <%= form.password_field :password,
                            autocomplete: "new-password",
                            required: required,
                            class: "vertiso-auth-field__input #{theme.field} #{theme.focus}" %>
  </div>

  <div class="vertiso-auth-field">
    <%= form.label :password_confirmation,
                   t("vertiso.authentication.components.password_field.confirmation"),
                   class: "vertiso-auth-field__label #{theme.foreground}" %>
    <%= form.password_field :password_confirmation,
                            autocomplete: "new-password",
                            required: required,
                            class: "vertiso-auth-field__input #{theme.field} #{theme.focus}" %>
  </div>
</div>
