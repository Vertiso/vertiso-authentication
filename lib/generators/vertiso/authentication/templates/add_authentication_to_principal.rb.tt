<%
  migration_class_name =
    if defined?(principal_seed_migration_class_name)
      principal_seed_migration_class_name
    else
      "AddAuthenticationToPrincipal"
    end
%>
# Adds the browser-session invalidation seed to the host principal table.
class <%= migration_class_name %> < ActiveRecord::Migration[8.1]
  def change
    add_column :<%= principal_table_name %>, :session_token_seed, :string

    reversible do |direction|
      direction.up do
        principal = Class.new(ActiveRecord::Base) do
          self.table_name = :<%= principal_table_name %>
        end
        principal.reset_column_information
        principal.where(session_token_seed: nil).find_each do |record|
          record.update!(session_token_seed: SecureRandom.hex(16))
        end
      end
    end

    change_column_default :<%= principal_table_name %>,
                          :session_token_seed,
                          from: nil,
                          to: ''
    change_column_null :<%= principal_table_name %>, :session_token_seed, false
  end
end
